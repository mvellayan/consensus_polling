# Copy to aws/.env for local overrides. Both files are sourced by _lib.sh with
# `set -a`, so every assignment is exported. Quote values containing spaces.

AWS_REGION=us-east-1
AWS_PROFILE=default
APP_NAME=scotus
APP_DOMAIN=scotus.me
STACK_NAME=ScotusStack
TABLE_PREFIX=scotus

# SSM SecureString the Lambda reads the OpenAI key from at runtime.
# Must match parameter_name in infra/scotus_stack.py.
OPENAI_API_KEY_PARAM=/scotus/openai-api-key

# Used ONLY by create.sh to seed the SSM SecureString above on first deploy.
# Leave commented in env.example; set it in aws/.env (which is gitignored).
#OPENAI_API_KEY=sk-...
